# Токен бота, полученный у @BotFather
BOT_TOKEN=123456789:AA...

# ID чата/группы/канала, куда бот будет писать "Відбій тривоги".
# Для личного чата — это ваш числовой user_id.
# Для группы — обычно отрицательное число, например -1001234567890.
# Узнать можно, например, через бота @userinfobot или @getmyid_bot.
CHAT_ID=-1001234567890

# Токен API alerts.in.ua: https://alerts.in.ua -> "Отримати токен API"
ALERTS_TOKEN=your_alerts_in_ua_token

# Область ровно так, как она называется в alerts.in.ua
REGION_TITLE=Миколаївська область

# Как часто опрашивать API тревог, в секундах
POLL_INTERVAL_SECONDS=15

# Слать ли отдельное сообщение при НАЧАЛЕ тревоги (true/false)
NOTIFY_ON_START=true

# Группа недель для предметов, что чередуются (Мистецтво/Музика и т.п.):
# auto (авторасчёт по числу месяца), 1_2 или 3_4
WEEK_GROUP_OVERRIDE=auto

# Telegram user_id тех, кому разрешено отмечать уроки отменёнными
# (команды /cancel, /uncancel, /cancelled - работают только в ЛС с ботом).
# Несколько ID через запятую. Узнать свой user_id - у @userinfobot.
ADMIN_IDS=123456789

# Во сколько (по Europe/Kyiv, ЧЧ:ММ) слать в чат полное расписание
# на сегодня. off - выключить ранковую рассылку.
MORNING_DIGEST_TIME=10:00

# Дата (РРРР-ММ-ДД) любого понедельника, когда класс учился ОЧНО в
# школе. Дальше бот сам считает чередование недель (через неделю -
# дома, ещё через неделю - снова в школе, и т.д.). Пусто - метка
# "школа/вдома" нигде не показывается.
SCHOOL_WEEK_ANCHOR_MONDAY=2026-09-07

# Слать ли сообщения о начале/отбое тревоги в субботу и воскресенье.
# false (по умолчанию) - в выходные бот молчит (мониторинг в фоне
# продолжается, просто без сообщений в чат).
NOTIFY_ALERTS_ON_WEEKENDS=false

# Часовий діапазон (Europe/Kyiv, ЧЧ:ММ), коли слати повідомлення про
# тривогу/відбій у чат. Поза цим діапазоном - бот мовчить (моніторинг
# у фоні продовжується). off в обох полях - без обмежень за часом.
ALERT_NOTIFY_FROM=10:00
ALERT_NOTIFY_TO=19:00

# За сколько минут до начала следующего урока слать короткое
# напоминание в чат. off - выключить.
LESSON_REMINDER_MINUTES=5

# Во сколько (Europe/Kyiv, ЧЧ:ММ) в воскресенье вечером слать
# админам в ЛС сообщение о типе следующей недели (школа/дома).
# Работает только если задан SCHOOL_WEEK_ANCHOR_MONDAY. off - выключить.
WEEK_TYPE_REMINDER_TIME=19:00

# Во сколько (Europe/Kyiv, ЧЧ:ММ) в очный день бот спрашивает в ЛС
# админов, будет ли 7-й/8-й урок очно (иначе по умолчанию дистанційно).
# off - выключить.
REMOTE_CONFIRM_TIME=12:00

# HTTPS-адреса міні-застосунку (miniapp/index.html, напр. GitHub Pages).
# Порожньо - команда /app і кнопка меню вимкнені.
MINIAPP_URL=

# Публічна адреса бота для API міні-застосунку (https://...). На Railway не потрібна,
# якщо згенеровано домен (береться з RAILWAY_PUBLIC_DOMAIN).
BOT_PUBLIC_URL=
